<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              name="LaporanPendapatan" language="java"
              pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="20" rightMargin="20"
              topMargin="30" bottomMargin="30">

    <property name="ireport.encoding" value="UTF-8"/>

    <parameter name="REPORT_TITLE" class="java.lang.String"/>
    <parameter name="PERIODE_DARI" class="java.lang.String"/>
    <parameter name="PERIODE_SAMPAI" class="java.lang.String"/>
    <parameter name="PRINTED_DATE" class="java.util.Date"/>
    <parameter name="PRINTED_BY" class="java.lang.String"/>

    <queryString>
        <![CDATA[
            SELECT
                l.nama AS nama_lapangan,
                l.jenis,
                COUNT(r.id) AS total_booking,
                COALESCE(SUM(r.total_harga), 0) AS total_pendapatan
            FROM lapangan l
            LEFT JOIN reservasi r ON l.id = r.lapangan_id
                AND r.tanggal BETWEEN $P{PERIODE_DARI} AND $P{PERIODE_SAMPAI}
                AND r.status IN ('dibayar', 'selesai')
            GROUP BY l.id, l.nama, l.jenis
            ORDER BY total_pendapatan DESC
        ]]>
    </queryString>

    <field name="nama_lapangan" class="java.lang.String"/>
    <field name="jenis" class="java.lang.String"/>
    <field name="total_booking" class="java.lang.Long"/>
    <field name="total_pendapatan" class="java.math.BigDecimal"/>

    <variable name="GRAND_TOTAL" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{total_pendapatan}]]></variableExpression>
    </variable>

    <background>
        <band splitType="Stretch"/>
    </background>

    <title>
        <band height="65">
            <staticText>
                <reportElement x="0" y="0" width="535" height="35"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[SPORT BOOKING SYSTEM]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="35" width="535" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[$P{REPORT_TITLE}]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="62" width="535" height="1"/>
            </line>
        </band>
    </title>

    <pageHeader>
        <band height="35">
            <textField>
                <reportElement x="0" y="5" width="535" height="15"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Dicetak: " + new java.text.SimpleDateFormat("dd MMMM yyyy, HH:mm").format($P{PRINTED_DATE})]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="20" width="535" height="15"/>
                <textElement textAlignment="Left"/>
                <textFieldExpression><![CDATA["Periode: " + $P{PERIODE_DARI} + " s/d " + $P{PERIODE_SAMPAI}]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>

    <columnHeader>
        <band height="25">
            <staticText>
                <reportElement x="0" y="0" width="40" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[No]]></text>
            </staticText>
            <staticText>
                <reportElement x="40" y="0" width="180" height="25"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"/>
                <text><![CDATA[Nama Lapangan]]></text>
            </staticText>
            <staticText>
                <reportElement x="220" y="0" width="80" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Jenis]]></text>
            </staticText>
            <staticText>
                <reportElement x="300" y="0" width="100" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Total Booking]]></text>
            </staticText>
            <staticText>
                <reportElement x="400" y="0" width="135" height="25"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <text><![CDATA[Total Pendapatan]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="40" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="40" y="0" width="180" height="20"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{nama_lapangan}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="220" y="0" width="80" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{jenis}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="300" y="0" width="100" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{total_booking}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0">
                <reportElement x="400" y="0" width="135" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{total_pendapatan}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="55">
            <line>
                <reportElement x="0" y="0" width="535" height="1"/>
            </line>
            <textField pattern="#,##0">
                <reportElement x="0" y="10" width="535" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["Grand Total: Rp " + $V{GRAND_TOTAL}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="35" width="535" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["Dicetak oleh: " + $P{PRINTED_BY}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>