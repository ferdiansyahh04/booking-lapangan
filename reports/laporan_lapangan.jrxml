<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              name="LaporanLapangan" language="java"
              pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="20" rightMargin="20"
              topMargin="30" bottomMargin="30">

    <property name="ireport.encoding" value="UTF-8"/>

    <!-- Parameters -->
    <parameter name="REPORT_TITLE" class="java.lang.String"/>
    <parameter name="PERIODE_DARI" class="java.lang.String"/>
    <parameter name="PERIODE_SAMPAI" class="java.lang.String"/>
    <parameter name="PRINTED_DATE" class="java.util.Date"/>
    <parameter name="PRINTED_BY" class="java.lang.String"/>

    <!-- Query -->
    <queryString>
        <![CDATA[
            SELECT
                l.id,
                l.nama,
                l.jenis,
                l.status,
                l.harga_per_jam,
                COUNT(r.id) AS total_booking,
                COALESCE(SUM(r.durasi_jam), 0) AS total_jam
            FROM lapangan l
            LEFT JOIN reservasi r ON l.id = r.lapangan_id
                AND r.tanggal BETWEEN $P{PERIODE_DARI} AND $P{PERIODE_SAMPAI}
                AND r.status != 'dibatalkan'
            GROUP BY l.id, l.nama, l.jenis, l.status, l.harga_per_jam
            ORDER BY total_jam DESC, l.nama ASC
        ]]>
    </queryString>

    <!-- Fields -->
    <field name="id" class="java.lang.Integer"/>
    <field name="nama" class="java.lang.String"/>
    <field name="jenis" class="java.lang.String"/>
    <field name="status" class="java.lang.String"/>
    <field name="harga_per_jam" class="java.math.BigDecimal"/>
    <field name="total_booking" class="java.lang.Long"/>
    <field name="total_jam" class="java.lang.Long"/>

    <!-- Background -->
    <background>
        <band splitType="Stretch"/>
    </background>

    <!-- Title -->
    <title>
        <band height="65">
            <staticText>
                <reportElement x="0" y="0" width="535" height="35"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[SPORT BOOKING SYSTEM]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="35" width="535" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[$P{REPORT_TITLE}]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="62" width="535" height="1"/>
            </line>
        </band>
    </title>

    <!-- Page Header -->
    <pageHeader>
        <band height="35">
            <textField>
                <reportElement x="0" y="5" width="535" height="15"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Dicetak: " + new java.text.SimpleDateFormat("dd MMMM yyyy, HH:mm").format($P{PRINTED_DATE})]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="20" width="535" height="15"/>
                <textElement textAlignment="Left"/>
                <textFieldExpression><![CDATA["Periode: " + $P{PERIODE_DARI} + " s/d " + $P{PERIODE_SAMPAI}]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>

    <!-- Column Header -->
    <columnHeader>
        <band height="25">
            <staticText>
                <reportElement x="0" y="0" width="50" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[No]]></text>
            </staticText>
            <staticText>
                <reportElement x="50" y="0" width="150" height="25"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"/>
                <text><![CDATA[Nama Lapangan]]></text>
            </staticText>
            <staticText>
                <reportElement x="200" y="0" width="80" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Jenis]]></text>
            </staticText>
            <staticText>
                <reportElement x="280" y="0" width="80" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Status]]></text>
            </staticText>
            <staticText>
                <reportElement x="360" y="0" width="80" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Total Booking]]></text>
            </staticText>
            <staticText>
                <reportElement x="440" y="0" width="95" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Total Jam]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- Detail -->
    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="50" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="50" y="0" width="150" height="20"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{nama}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="200" y="0" width="80" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{jenis}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="280" y="0" width="80" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="360" y="0" width="80" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{total_booking}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="440" y="0" width="95" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[String.valueOf($F{total_jam}) + " jam"]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- Summary -->
    <summary>
        <band height="45">
            <line>
                <reportElement x="0" y="0" width="535" height="1"/>
            </line>
            <textField>
                <reportElement x="0" y="10" width="535" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["Total: " + $V{REPORT_COUNT} + " lapangan"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="30" width="535" height="15"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["Dicetak oleh: " + $P{PRINTED_BY}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>